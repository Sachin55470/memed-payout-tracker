PORT=5000
NODE_ENV=development

# Must be a replica set (MongoDB Atlas is one by default) because the views update uses a transaction
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed-payout-tracker

# Used to sign the access token
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379

# Frontend URL, allowed by CORS
CLIENT_URL=http://localhost:3000
